from pathlib import Path
import json

from openpyxl import load_workbook


MAPPING_FOLDER = Path("./mapping")
INPUT_FOLDER = Path("./input")
OUTPUT_FOLDER = Path("./output")
OUTPUT_FOLDER.mkdir(exist_ok=True)

MODEL_NAME = "cyankiwi/Qwen3.6-35B-A3B-AWQ-4bit"


def read_excel_cells(path: Path) -> list[dict]:
    """Извлекает все заполненные ячейки со всех листов Excel."""

    workbook = load_workbook(
        path,
        data_only=True,
        read_only=False,
    )

    result = []

    for sheet in workbook.worksheets:
        for row in sheet.iter_rows():
            for cell in row:
                if cell.value is None:
                    continue

                value = str(cell.value).strip()

                if not value:
                    continue

                result.append({
                    "sheet": sheet.title,
                    "cell": cell.coordinate,
                    "value": value,
                })

    workbook.close()
    return result


# Находим маппинг-файл
mapping_files = list(MAPPING_FOLDER.glob("*.xlsx"))

if len(mapping_files) != 1:
    raise RuntimeError(
        f"В папке mapping должен быть один XLSX. "
        f"Найдено: {len(mapping_files)}"
    )

mapping_cells = read_excel_cells(mapping_files[0])


# Ищем одноимённые пары XLSX + JSON
for excel_path in INPUT_FOLDER.glob("*.xlsx"):

    json_path = excel_path.with_suffix(".json")

    if not json_path.exists():
        print(f"[SKIP] Не найден JSON для {excel_path.name}")
        continue

    excel_cells = read_excel_cells(excel_path)

    with open(json_path, "r", encoding="utf-8-sig") as file:
        json_data = json.load(file)

    prompt = f"""
Необходимо проверить корректность JSON по отношению к исходному Excel-файлу.

Маппинг представлен Excel-шаблоном, а не обычной таблицей.
Русское название поля и соответствующее английское название могут:

- находиться в соседних ячейках;
- находиться в одной ячейке;
- быть разделены символами "-", "—", пробелом или переносом строки;
- находиться в разных частях одной строки формы.

Сначала самостоятельно определи соответствия:

русское название поля → английское название поля JSON.

Не считай значениями названия разделов, заголовки формы, пояснения,
служебные надписи и примеры заполнения.

ЯЧЕЙКИ МАППИНГ-ФАЙЛА:
{json.dumps(mapping_cells, ensure_ascii=False, indent=2)}

ЯЧЕЙКИ EXCEL С ЭТАЛОННЫМИ ДАННЫМИ:
{json.dumps(excel_cells, ensure_ascii=False, indent=2)}

ПРОВЕРЯЕМЫЙ JSON:
{json.dumps(json_data, ensure_ascii=False, indent=2)}

Порядок проверки:

1. Построй маппинг русских и английских названий полей.
2. Найди значения соответствующих полей в Excel с данными.
3. Сравни их со значениями одноимённых английских полей JSON.
4. Покажи только ошибки и расхождения.

Для каждого расхождения укажи:

- русское название поля;
- английское название поля;
- значение в Excel;
- значение в JSON;
- тип ошибки;
- краткое пояснение.

Типы ошибок:

- поле отсутствует в JSON;
- неверное значение;
- лишнее поле в JSON;
- поле присутствует, но пустое;
- не найдено соответствие в маппинге;
- значение невозможно однозначно определить.

Учитывай эквивалентность чисел 100 и 100.0, а также дат,
записанных в разных стандартных форматах.

Не придумывай отсутствующие значения.
Если все данные совпадают, напиши:
«Расхождения между Excel и JSON не обнаружены».

Верни только результат проверки.
"""

    response = llm_client.chat.completions.create(
        model=MODEL_NAME,
        messages=[
            {
                "role": "user",
                "content": prompt,
            }
        ],
        temperature=0,
        max_tokens=6000,
        extra_body={
            "chat_template_kwargs": {
                "enable_thinking": True,
            }
        },
    )

    result = response.choices[0].message.content

    if not result:
        raise RuntimeError(
            f"Модель не вернула ответ для {excel_path.name}"
        )

    output_path = (
        OUTPUT_FOLDER
        / f"{excel_path.stem}_comparison.txt"
    )

    output_path.write_text(
        result,
        encoding="utf-8",
    )

    print(f"\nПроверка: {excel_path.name}")
    print(result)
    print(f"\nСохранено: {output_path}")
