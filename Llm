import json
import pandas as pd
from openai import OpenAI

FILE = "input.xlsx"
MODEL = "ваша_модель"

client = OpenAI(
    api_key="ВАШ_API_KEY",
    base_url="ВАШ_BASE_URL"
)

# Читаем Excel как есть, включая пустые строки/столбцы
df = pd.read_excel(FILE, header=None)

# Превращаем таблицу в текст
excel_text = df.fillna("").astype(str).to_csv(
    index=False,
    header=False,
    sep="|"
)

prompt = f"""
Ниже содержимое Excel-файла с маппингом полей.

Твоя задача:
1. Найти названия полей на русском языке.
2. Определить соответствующие им названия полей на английском языке.
3. Вернуть ТОЛЬКО валидный JSON.
4. Ключ JSON — английское название поля.
5. Значение JSON — соответствующее русское название поля.
6. Не добавляй пояснения, markdown и ```json.
7. Не придумывай соответствия. Если связь между русским и английским
   названием нельзя однозначно определить — не включай такое поле в JSON.
8. Сохраняй английские названия точно так, как они записаны в Excel.

Пример результата:
{{
  "DepartmentCode": "Код подразделения",
  "LoanAgreementDate": "Дата заключения кредитного договора",
  "BorrowerName": "Наименование заемщика"
}}

Содержимое Excel:

{excel_text}
"""

response = client.chat.completions.create(
    model=MODEL,
    messages=[
        {"role": "user", "content": prompt}
    ],
    temperature=0
)

result = response.choices[0].message.content

data = json.loads(result)

data
