def analyze_excel_file(
    file_path: Path
) -> dict[str, Any]:
    """
    Читает первый лист Excel, делит данные на части,
    анализирует их и формирует отчет по файлу.
    """

    print("\n" + "=" * 90)
    print(f"Файл: {file_path.name}")

    # Так как каждый Excel содержит один лист,
    # читаем первый лист по умолчанию.
    df = pd.read_excel(
        file_path,
        sheet_name=0
    )

    df = prepare_dataframe(df)

    if df.empty:
        raise ValueError(
            f"Файл {file_path.name} не содержит данных."
        )

    print(f"Строк: {len(df):,}")
    print(f"Столбцов: {len(df.columns):,}")

    chunks = split_dataframe_by_size(
        df,
        max_chars=MAX_DATA_CHARS
    )

    print(f"Частей для анализа: {len(chunks)}")

    partial_results = []

    for part_number, chunk in enumerate(
        chunks,
        start=1
    ):
        print(
            f"  Анализ части {part_number}/{len(chunks)}: "
            f"строки {chunk['start_row']}–{chunk['end_row']}, "
            f"{len(chunk['json']):,} символов"
        )

        try:
            result = analyze_chunk(
                file_name=file_path.name,
                chunk_json=chunk["json"],
                part_number=part_number,
                total_parts=len(chunks),
                start_row=chunk["start_row"],
                end_row=chunk["end_row"]
            )

        except Exception as error:
            print(
                f"  Ошибка анализа части {part_number}: "
                f"{type(error).__name__}: {error}"
            )

            raise

        partial_results.append(result)

        time.sleep(REQUEST_DELAY_SECONDS)

    print("  Консолидация результатов по файлу...")

    consolidated_result = consolidate_file_results(
        file_name=file_path.name,
        partial_results=partial_results,
        total_rows=len(df)
    )

    # Сохраняем анализ отдельных частей.
    parts_output_path = (
        OUTPUT_FOLDER /
        f"{file_path.stem}_parts_analysis.md"
    )

    parts_text = "\n\n---\n\n".join(
        (
            f"# {file_path.name} — часть {index} "
            f"из {len(partial_results)}\n\n{result}"
        )
        for index, result in enumerate(
            partial_results,
            start=1
        )
    )

    parts_output_path.write_text(
        parts_text,
        encoding="utf-8"
    )

    # Сохраняем итоговый отчет по файлу.
    final_output_path = (
        OUTPUT_FOLDER /
        f"{file_path.stem}_final_analysis.md"
    )

    final_output_path.write_text(
        consolidated_result,
        encoding="utf-8"
    )

    print(
        f"  Итог сохранен: {final_output_path}"
    )

    return {
        "file_name": file_path.name,
        "rows": len(df),
        "columns": len(df.columns),
        "parts": len(chunks),
        "result": consolidated_result
    }


# ============================================================
# 9. ОБЩАЯ КОНСОЛИДАЦИЯ ПО ВСЕМ ФАЙЛАМ
# ============================================================

def consolidate_all_files(
    file_results: list[dict[str, Any]]
) -> str:
    """
    Формирует общий отчет по всем Excel-файлам.
    """

    combined = "\n\n".join(
        f"""
# Файл: {item["file_name"]}

Количество строк: {item["rows"]}
Количество столбцов: {item["columns"]}
Количество частей анализа: {item["parts"]}

{item["result"]}
""".strip()
        for item in file_results
    )

    blocks = split_text_by_size(
        combined,
        MAX_CONSOLIDATION_CHARS
    )

    intermediate_results = []

    for block_number, block in enumerate(
        blocks,
        start=1
    ):
        print(
            f"Общая консолидация: блок "
            f"{block_number}/{len(blocks)}"
        )

        prompt = f"""
Ниже представлены итоговые отчеты по нескольким Excel-файлам,
относящимся к анализу бизнес-процесса.

Текущий блок:
{block_number} из {len(blocks)}

Задача:

1. Выяви сквозные закономерности между файлами.
2. Сопоставь взаимосвязанные показатели.
3. Объедини повторяющиеся выводы.
4. Отметь противоречия между наборами метрик.
5. Сохрани названия файлов — источников выводов.
6. Не придумывай факты и числовые показатели.

ОТЧЕТЫ ПО ФАЙЛАМ:

{block}
"""

        result = ask_model(
            system_prompt=(
                "Ты консолидируешь результаты анализа "
                "нескольких наборов метрик Process Mining."
            ),
            user_prompt=prompt,
            max_tokens=CONSOLIDATION_MAX_TOKENS
        )

        intermediate_results.append(result)

        time.sleep(REQUEST_DELAY_SECONDS)

    combined_intermediate = "\n\n".join(
        f"# Блок {index}\n\n{result}"
        for index, result in enumerate(
            intermediate_results,
            start=1
        )
    )

    # На случай, если даже результаты общей консолидации
    # не помещаются в один финальный запрос.
    while len(combined_intermediate) > MAX_CONSOLIDATION_CHARS:
        next_blocks = split_text_by_size(
            combined_intermediate,
            MAX_CONSOLIDATION_CHARS
        )

        next_results = []

        for index, block in enumerate(
            next_blocks,
            start=1
        ):
            prompt = f"""
Сократи и объедини данный блок результатов анализа.

Удали дубли, сохрани числовые показатели, названия файлов,
ключевые проблемы, риски и рекомендации.

Не придумывай новые факты.

БЛОК:

{block}
"""

            next_result = ask_model(
                system_prompt=(
                    "Ты выполняешь промежуточную консолидацию "
                    "аналитических выводов."
                ),
                user_prompt=prompt,
                max_tokens=CONSOLIDATION_MAX_TOKENS
            )

            next_results.append(next_result)

            time.sleep(REQUEST_DELAY_SECONDS)

        combined_intermediate = "\n\n".join(
            f"# Укрупненный блок {index}\n\n{result}"
            for index, result in enumerate(
                next_results,
                start=1
            )
        )

    final_prompt = f"""
На основании итоговых отчетов по всем Excel-файлам сформируй
единый управленческий отчет по процессу.

Требования:

1. Не рассматривай файлы изолированно — найди связи между ними.
2. Сформулируй основные сквозные проблемы процесса.
3. Сохрани конкретные числовые показатели и источники.
4. Отдели подтвержденные выводы от гипотез.
5. Удали дублирующиеся рекомендации.
6. Приоритизируй действия.
7. Не придумывай отсутствующие факты.
8. Ответ дай на русском языке в Markdown.

Структура:

# Сводный анализ процесса

## Управленческое резюме

## Сквозные закономерности и узкие места

| № | Вывод | Подтверждение | Файлы-источники | Последствия | Приоритет |
|---|---|---|---|---|---|

## Противоречия и ограничения данных

## Приоритетный план действий

| № | Действие | Основание | Ожидаемый эффект | Приоритет |
|---|---|---|---|---|

## Топ-5 наиболее значимых выводов

## Дополнительные данные, необходимые для проверки выводов

КОНСОЛИДИРОВАННЫЕ МАТЕРИАЛЫ:

{combined_intermediate}
"""

    return ask_model(
        system_prompt=(
            "Ты ведущий эксперт по Process Mining. "
            "Подготовь точный сводный отчет для руководства."
        ),
        user_prompt=final_prompt,
        max_tokens=FINAL_MAX_TOKENS
    )


