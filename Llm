def ask_model(
    system_prompt: str,
    user_prompt: str,
    max_tokens: int,
) -> str:
    current_max_tokens = max_tokens
    empty_content_attempts = 0

    for attempt in range(1, MAX_RETRIES + 1):
        try:
            response = llm_client.chat.completions.create(
                model=MODEL_NAME,
                messages=[
                    {
                        "role": "system",
                        "content": system_prompt,
                    },
                    {
                        "role": "user",
                        "content": user_prompt,
                    },
                ],
                temperature=TEMPERATURE,
                max_tokens=current_max_tokens,
                extra_body={
                    "chat_template_kwargs": {
                        "enable_thinking": True,
                    }
                },
            )

            message = response.choices[0].message

            content = (
                message.content.strip()
                if message.content
                else ""
            )

            if content:
                return content

            empty_content_attempts += 1

            if empty_content_attempts >= 3:
                raise RuntimeError(
                    "Модель выполнила reasoning, "
                    "но не вернула итоговый ответ."
                )

            current_max_tokens = min(
                current_max_tokens + 2_000,
                12_000,
            )

            time.sleep(10)

        except RateLimitError:
            if attempt >= MAX_RETRIES:
                raise

            log(
                "Достигнут лимит API. "
                f"Ожидание {RATE_LIMIT_WAIT_SECONDS} секунд."
            )

            time.sleep(
                RATE_LIMIT_WAIT_SECONDS
            )

        except (
            APIConnectionError,
            APITimeoutError,
        ) as error:
            if attempt >= MAX_RETRIES:
                raise

            wait_seconds = min(
                10 * attempt,
                60,
            )

            log(
                f"Ошибка подключения: {error}. "
                f"Повтор через {wait_seconds} секунд."
            )

            time.sleep(wait_seconds)

        except APIStatusError as error:
            if (
                error.status_code >= 500
                and attempt < MAX_RETRIES
            ):
                wait_seconds = min(
                    10 * attempt,
                    60,
                )

                log(
                    f"Ошибка Gateway HTTP "
                    f"{error.status_code}. "
                    f"Повтор через {wait_seconds} секунд."
                )

                time.sleep(wait_seconds)
                continue

            raise

    raise RuntimeError(
        "Не удалось получить ответ модели."
    )


