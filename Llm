import pandas as pd
from IPython.display import display

FILE = "Приложение 2.xlsx"
SHEET = 0

# Первые 2 строки пропускаются,
# строки 3 и 4 Excel становятся двухуровневой шапкой
df = pd.read_excel(
    FILE,
    sheet_name=SHEET,
    header=[2, 3]
)

# Убираем надписи Unnamed из заголовков
df.columns = pd.MultiIndex.from_tuples([
    (
        "" if str(a).startswith("Unnamed:") else str(a),
        "" if str(b).startswith("Unnamed:") else str(b)
    )
    for a, b in df.columns
])

# Не ограничиваем количество строк/столбцов
pd.set_option("display.max_rows", None)
pd.set_option("display.max_columns", None)
pd.set_option("display.max_colwidth", None)
pd.set_option("display.width", None)

# Красивый вывод
styled = (
    df.style
    .set_properties(**{
        "text-align": "center",
        "vertical-align": "middle",
        "white-space": "normal",
        "border": "1px solid #999",
        "padding": "5px"
    })
    .set_table_styles([
        {
            "selector": "th",
            "props": [
                ("text-align", "center"),
                ("vertical-align", "middle"),
                ("white-space", "normal"),
                ("border", "1px solid #777"),
                ("padding", "6px"),
                ("font-weight", "bold")
            ]
        },
        {
            "selector": "table",
            "props": [
                ("border-collapse", "collapse")
            ]
        }
    ])
)

display(styled)
