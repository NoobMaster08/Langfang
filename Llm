def normalize_value(value: Any) -> Any:
    """
    Преобразует значения pandas/numpy в JSON-совместимый вид.
    """

    if value is None:
        return None

    try:
        if pd.isna(value):
            return None
    except (TypeError, ValueError):
        pass

    if isinstance(value, (pd.Timestamp, datetime, date)):
        return value.isoformat()

    if isinstance(value, np.integer):
        return int(value)

    if isinstance(value, np.floating):
        value = float(value)

        if math.isnan(value) or math.isinf(value):
            return None

        return value

    if isinstance(value, np.bool_):
        return bool(value)

    if isinstance(value, (str, int, float, bool)):
        return value

    return str(value)


def prepare_dataframe(df: pd.DataFrame) -> pd.DataFrame:
    """
    Удаляет полностью пустые строки и столбцы,
    а также приводит названия столбцов к строковому виду.
    """

    df = df.copy()

    df = df.dropna(axis=0, how="all")
    df = df.dropna(axis=1, how="all")

    df.columns = [
        str(column).strip()
        for column in df.columns
    ]

    df = df.reset_index(drop=True)

    return df


def dataframe_part_to_json(
    df: pd.DataFrame,
    start_row: int
) -> str:
    """
    Преобразует часть DataFrame в компактный JSON.

    Формат:
    {
        "columns": [...],
        "row_start": 1,
        "row_end": 300,
        "rows": [...]
    }
    """

    rows = []

    for row in df.itertuples(index=False, name=None):
        rows.append([
            normalize_value(value)
            for value in row
        ])

    payload = {
        "columns": [
            str(column)
            for column in df.columns
        ],
        "row_start": start_row + 1,
        "row_end": start_row + len(df),
        "rows": rows
    }

    return json.dumps(
        payload,
        ensure_ascii=False,
        separators=(",", ":")
    )


def split_dataframe_by_size(
    df: pd.DataFrame,
    max_chars: int = MAX_DATA_CHARS
) -> list[dict[str, Any]]:
    """
    Делит таблицу на части с учетом фактического размера JSON.

    Файлы до 300 строк могут пройти одним блоком.
    Файл на 5000 строк будет автоматически разделен
    на необходимое количество частей.
    """

    if df.empty:
        return []

    chunks: list[dict[str, Any]] = []

    start = 0
    total_rows = len(df)

    while start < total_rows:
        low = start + 1
        high = total_rows
        best_end = None
        best_json = None

        # Двоичный поиск максимального числа строк,
        # которые помещаются в установленный размер.
        while low <= high:
            middle = (low + high) // 2

            candidate_df = df.iloc[start:middle]

            candidate_json = dataframe_part_to_json(
                candidate_df,
                start_row=start
            )

            if len(candidate_json) <= max_chars:
                best_end = middle
                best_json = candidate_json
                low = middle + 1
            else:
                high = middle - 1

        # Даже одна строка оказалась слишком большой.
        if best_end is None:
            best_end = start + 1
            best_json = dataframe_part_to_json(
                df.iloc[start:best_end],
                start_row=start
            )

            print(
                f"Предупреждение: строка {start + 1} "
                f"занимает {len(best_json):,} символов."
            )

        chunks.append({
            "start_row": start + 1,
            "end_row": best_end,
            "json": best_json
        })

        start = best_end

    return chunks


def split_text_by_size(
    text: str,
    max_chars: int = MAX_CONSOLIDATION_CHARS
) -> list[str]:
    """
    Делит промежуточные выводы на текстовые блоки.
    Старается разрывать текст по границам разделов.
    """

    text = text.strip()

    if not text:
        return []

    if len(text) <= max_chars:
        return [text]

    sections = text.split("\n\n")
    chunks = []
    current_parts = []
    current_size = 0

    for section in sections:
        section_size = len(section) + 2

        if current_parts and current_size + section_size > max_chars:
            chunks.append("\n\n".join(current_parts))
            current_parts = []
            current_size = 0

        # Если один раздел сам по себе слишком большой.
        if section_size > max_chars:
            if current_parts:
                chunks.append("\n\n".join(current_parts))
                current_parts = []
                current_size = 0

            for position in range(0, len(section), max_chars):
                chunks.append(
                    section[position:position + max_chars]
                )

            continue

        current_parts.append(section)
        current_size += section_size

    if current_parts:
        chunks.append("\n\n".join(current_parts))

    return chunks


