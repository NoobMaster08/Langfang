def ask_model(
    system_prompt: str,
    user_prompt: str,
    max_tokens: int
) -> str:
    """
    Выполняет запрос с включенным reasoning.

    Если модель израсходовала лимит на рассуждение
    и не сформировала итоговый ответ, запрос повторяется
    с увеличенным лимитом.
    """

    current_max_tokens = max_tokens

    for attempt in range(1, MAX_RETRIES + 1):

        try:
            response = llm_client.chat.completions.create(
                model=MODEL_NAME,
                messages=[
                    {
                        "role": "system",
                        "content": system_prompt
                    },
                    {
                        "role": "user",
                        "content": user_prompt
                    }
                ],
                temperature=0.2,
                max_tokens=current_max_tokens,

                # Thinking остается включенным
                extra_body={
                    "chat_template_kwargs": {
                        "enable_thinking": True
                    }
                }
            )

            choice = response.choices[0]
            message = choice.message

            content = (
                message.content.strip()
                if message.content
                else ""
            )

            message_data = message.model_dump()

            reasoning = (
                message_data.get("reasoning")
                or message_data.get("reasoning_content")
                or ""
            )

            print(
                f"  finish_reason: {choice.finish_reason}; "
                f"reasoning: {len(reasoning):,} символов; "
                f"content: {len(content):,} символов"
            )

            if content:
                return content

            # Если content пустой, модель, вероятно,
            # исчерпала лимит на reasoning
            if attempt < MAX_RETRIES:
                current_max_tokens = min(
                    current_max_tokens + 2_000,
                    12_000
                )

                print(
                    "\n  Итоговый ответ отсутствует."
                    f"\n  Увеличиваем max_tokens "
                    f"до {current_max_tokens}."
                    f"\n  Повторная попытка "
                    f"{attempt + 1}/{MAX_RETRIES}..."
                )

                time.sleep(5)
                continue

            raise RuntimeError(
                "Модель завершила рассуждение, "
                "но не вернула итоговый ответ."
            )

        except RateLimitError:
            if attempt >= MAX_RETRIES:
                raise

            print(
                f"\n  Достигнут лимит API."
                f"\n  Ожидание "
                f"{RATE_LIMIT_WAIT_SECONDS} секунд."
            )

            time.sleep(RATE_LIMIT_WAIT_SECONDS)

        except (APIConnectionError, APITimeoutError) as error:
            if attempt >= MAX_RETRIES:
                raise

            wait_seconds = min(10 * attempt, 60)

            print(
                f"\n  Ошибка подключения: "
                f"{type(error).__name__}: {error}"
                f"\n  Повтор через {wait_seconds} секунд."
            )

            time.sleep(wait_seconds)

        except APIStatusError as error:
            if (
                error.status_code >= 500
                and attempt < MAX_RETRIES
            ):
                wait_seconds = min(10 * attempt, 60)

                print(
                    f"\n  Временная ошибка Gateway: "
                    f"HTTP {error.status_code}."
                    f"\n  Повтор через {wait_seconds} секунд."
                )

                time.sleep(wait_seconds)
                continue

            raise

    raise RuntimeError(
        "Не удалось получить ответ модели."
    )

