from pathlib import Path
import fitz  # PyMuPDF


# ============================================================
# НАСТРОЙКИ
# ============================================================

DPI = 400

# Название папки, в которую будут сохраняться изображения
OUTPUT_DIR_SUFFIX = "_rasterized"


# ============================================================
# PDF → PNG
# ============================================================

def pdf_to_images(pdf_path: Path, dpi: int = DPI) -> list[Path]:
    """
    Растрирует PDF в отдельные PNG-изображения.

    Параметры:
        pdf_path: путь к PDF-файлу
        dpi: разрешение растеризации, по умолчанию 400 DPI

    Возвращает:
        Список путей к созданным изображениям.
    """

    pdf_path = Path(pdf_path)

    # Проверяем существование файла
    if not pdf_path.exists():
        raise FileNotFoundError(
            f"PDF-файл не найден: {pdf_path}"
        )

    # Проверяем расширение
    if pdf_path.suffix.lower() != ".pdf":
        raise ValueError(
            f"Ожидался PDF-файл, получен: {pdf_path.suffix}"
        )

    # Создаём отдельную папку для результатов
    output_dir = (
        pdf_path.parent /
        f"{pdf_path.stem}{OUTPUT_DIR_SUFFIX}"
    )

    output_dir.mkdir(
        parents=True,
        exist_ok=True
    )

    image_paths = []

    # Открываем PDF
    doc = fitz.open(pdf_path)

    try:

        total_pages = len(doc)

        print(f"PDF: {pdf_path.name}")
        print(f"Страниц: {total_pages}")
        print(f"DPI: {dpi}")
        print(f"Формат: PNG")
        print(f"Папка результата: {output_dir}")
        print("-" * 60)

        # Коэффициент масштабирования
        zoom = dpi / 72

        matrix = fitz.Matrix(
            zoom,
            zoom
        )

        # Обрабатываем каждую страницу
        for page_idx, page in enumerate(doc):

            page_number = page_idx + 1

            print(
                f"Растрирование страницы "
                f"{page_number}/{total_pages}..."
            )

            # Рендерим страницу PDF в растровое изображение
            pix = page.get_pixmap(
                matrix=matrix,
                alpha=False
            )

            # Имя файла:
            # page_0001.png
            # page_0002.png
            # ...
            image_path = (
                output_dir /
                f"page_{page_number:04d}.png"
            )

            # Сохраняем PNG без потерь
            pix.save(
                str(image_path)
            )

            image_paths.append(image_path)

            print(
                f"  → {image_path.name} "
                f"({pix.width} × {pix.height})"
            )

    finally:
        doc.close()

    print("-" * 60)
    print(
        f"Готово. Обработано страниц: "
        f"{len(image_paths)}"
    )
    print(
        f"Изображения сохранены в:\n"
        f"{output_dir}"
    )

    return image_paths


# ============================================================
# ПРИМЕР ЗАПУСКА
# ============================================================

if __name__ == "__main__":

    pdf_path = Path(
        "document.pdf"
    )

    image_paths = pdf_to_images(
        pdf_path,
        dpi=400
    )

    print("\nСозданные файлы:")

    for image_path in image_paths:
        print(image_path)
