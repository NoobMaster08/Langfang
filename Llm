def log(message: str) -> None:
    if SHOW_PROGRESS:
        print(message)


def normalize_value(value: Any) -> Any:
    if value is None:
        return None

    try:
        if pd.isna(value):
            return None
    except (TypeError, ValueError):
        pass

    if isinstance(value, (pd.Timestamp, datetime, date)):
        return value.isoformat()

    if isinstance(value, np.integer):
        return int(value)

    if isinstance(value, np.floating):
        normalized = float(value)

        if math.isnan(normalized) or math.isinf(normalized):
            return None

        return normalized

    if isinstance(value, np.bool_):
        return bool(value)

    if isinstance(value, (str, int, float, bool)):
        return value

    return str(value)


def prepare_dataframe(df: pd.DataFrame) -> pd.DataFrame:
    df = df.copy()

    df = df.dropna(
        axis=0,
        how="all",
    )

    df = df.dropna(
        axis=1,
        how="all",
    )

    df.columns = [
        str(column).strip()
        for column in df.columns
    ]

    return df.reset_index(drop=True)


def dataframe_part_to_json(
    df: pd.DataFrame,
    start_row: int,
) -> str:
    rows = []

    for row in df.itertuples(
        index=False,
        name=None,
    ):
        rows.append([
            normalize_value(value)
            for value in row
        ])

    payload = {
        "columns": [
            str(column)
            for column in df.columns
        ],
        "row_start": start_row + 1,
        "row_end": start_row + len(df),
        "rows": rows,
    }

    return json.dumps(
        payload,
        ensure_ascii=False,
        separators=(",", ":"),
    )


def split_dataframe_by_size(
    df: pd.DataFrame,
    max_chars: int = MAX_DATA_CHARS,
) -> list[dict[str, Any]]:
    if df.empty:
        return []

    chunks = []

    start = 0
    total_rows = len(df)

    while start < total_rows:
        low = start + 1
        high = total_rows

        best_end = None
        best_json = None

        while low <= high:
            middle = (low + high) // 2

            candidate_df = df.iloc[start:middle]

            candidate_json = dataframe_part_to_json(
                candidate_df,
                start_row=start,
            )

            if len(candidate_json) <= max_chars:
                best_end = middle
                best_json = candidate_json
                low = middle + 1
            else:
                high = middle - 1

        if best_end is None:
            best_end = start + 1

            best_json = dataframe_part_to_json(
                df.iloc[start:best_end],
                start_row=start,
            )

        chunks.append({
            "start_row": start + 1,
            "end_row": best_end,
            "json": best_json,
        })

        start = best_end

    return chunks


def split_text_by_size(
    text: str,
    max_chars: int = MAX_CONSOLIDATION_CHARS,
) -> list[str]:
    text = text.strip()

    if not text:
        return []

    if len(text) <= max_chars:
        return [text]

    sections = text.split("\n\n")

    chunks = []
    current_parts = []
    current_size = 0

    for section in sections:
        section_size = len(section) + 2

        if (
            current_parts
            and current_size + section_size > max_chars
        ):
            chunks.append(
                "\n\n".join(current_parts)
            )

            current_parts = []
            current_size = 0

        if section_size > max_chars:
            if current_parts:
                chunks.append(
                    "\n\n".join(current_parts)
                )

                current_parts = []
                current_size = 0

            for position in range(
                0,
                len(section),
                max_chars,
            ):
                chunks.append(
                    section[
                        position:
                        position + max_chars
                    ]
                )

            continue

        current_parts.append(section)
        current_size += section_size

    if current_parts:
        chunks.append(
            "\n\n".join(current_parts)
        )

    return chunks


