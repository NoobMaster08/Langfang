CLASSIFICATION_PROMPT = """
Ты классифицируешь документ по справочнику правил.

Тебе переданы:
1. Справочник тематик.
2. Для каждой тематики — № п/п и алгоритм определения.
3. Полный текст одного документа.

Задача:
- внимательно проанализировать весь документ;
- сопоставить его со всеми правилами справочника;
- учитывать совокупность условий, а не отдельные ключевые слова;
- если правило содержит несколько условий, проверить каждое;
- ничего не придумывать;
- выбрать ровно один наиболее подходящий № п/п.

Верни № п/п строго в том виде, в котором он указан в справочнике.

Если ни одно правило не подходит достаточно уверенно, верни:

{
  "n_pp": "Не определено"
}

Ответ должен содержать только JSON:

{
  "n_pp": "..."
}
"""

def classify_text(document_text: str) -> dict:

    response = client.chat.completions.create(
        model=MODEL,

        messages=[
            {
                "role": "system",
                "content": CLASSIFICATION_PROMPT,
            },
            {
                "role": "user",
                "content": f"""СПРАВОЧНИК ТЕМАТИК:

{rules_text}

ТЕКСТ ДОКУМЕНТА:

{document_text}
""",
            },
        ],

        temperature=0,

        response_format={
            "type": "json_object"
        },

        extra_body={
            "top_k": 20,
            "chat_template_kwargs": {
                "enable_thinking": True
            },
        },
    )

    raw = response.choices[0].message.content.strip()

    return json.loads(raw)

def validate_result(result: dict) -> dict:

    n_pp = str(
        result.get("n_pp", "")
    ).strip()

    if n_pp == "Не определено":
        return {
            "n_pp": "Не определено",
            "topic": "Не определено"
        }

    matches = rules_clean[
        rules_clean[COL_N_PP] == n_pp
    ]

    if matches.empty:
        raise ValueError(
            f"Модель вернула № п/п '{n_pp}', "
            f"которого нет в Excel"
        )

    topic = matches.iloc[0][COL_TOPIC]

    return {
        "n_pp": n_pp,
        "topic": topic
    }
